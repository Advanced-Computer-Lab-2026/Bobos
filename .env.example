PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/bobos?replicaSet=rs0

# Leave empty for local Vite proxy. For separate production hosting, set this
# in the frontend build environment to the public API origin (no trailing slash).
VITE_API_BASE_URL=

# Production API CORS allowlist: frontend origin(s), comma-separated.
WEB_ORIGIN=

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Password-reset email. Enter the provider settings in your ignored .env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development accounts only; disabled by default and always disabled in production.
ALLOW_DEMO_SEED=true
